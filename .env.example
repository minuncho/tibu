# Copy to .env.local and fill in. With nothing set, the app runs in demo mode
# (fake login, local JSON storage, no AI conversion).

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extra Google account emails allowed into /staff (comma-separated).
# The owner account is already built in (see src/lib/server/env.ts).
STAFF_EMAILS=

# Toss in-app version (tibu-toss). Leave empty if you do not run it.
# PEM text of the mTLS certificate and key from the Apps in Toss console.
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
# Any long random string
TOSS_SESSION_SECRET=

# OpenAI (image conversion)
OPENAI_API_KEY=
# Optional override, default: gpt-image-2.5-sunburst
OPENAI_IMAGE_MODEL=
