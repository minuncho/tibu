# Copy to .env.local and fill in. With nothing set, the app runs in demo mode
# (fake login, local JSON storage, no AI conversion).

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google account emails that can review reports at /staff (comma-separated)
STAFF_EMAILS=

# OpenAI (image conversion)
OPENAI_API_KEY=
# Optional override, default: gpt-image-1
OPENAI_IMAGE_MODEL=
