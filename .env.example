# Copy to .env.local and fill in. With nothing set, the app runs in demo mode
# (fake login, local JSON storage, no AI conversion).

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extra Google account emails allowed into /staff (comma-separated).
# The owner account is already built in (see src/lib/server/env.ts).
STAFF_EMAILS=

# OpenAI (image conversion)
OPENAI_API_KEY=
# Optional override, default: gpt-image-1
OPENAI_IMAGE_MODEL=
